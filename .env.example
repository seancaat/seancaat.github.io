# Create a Notion integration: https://www.notion.so/my-integrations
# Share your projects database (and optional intro page) with the integration.

NOTION_TOKEN=

# From the database URL: notion.so/workspace/DATABASE_ID?v=...
NOTION_PROJECTS_DATABASE_ID=

# Optional. Only if you have multiple data sources on one database (uncommon).
# NOTION_DATA_SOURCE_ID=

# Optional. Paste full Notion page URL or slug ending in …-32hex (see README).
# NOTION_INTRO_PAGE_ID=

# Optional. Content below projects (e.g. teaching, press). Same URL format as intro.
# NOTION_OUTRO_PAGE_ID=
